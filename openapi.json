        "required": [
          "code",
          "entities",
          "title"
        ],
        "type": "object",
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "entities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogEntityDto"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogContextDto"
            },
            "nullable": true
          },
          "icon": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CatalogEntityDto": {
        "required": [
          "code",
          "title"
        ],
        "type": "object",
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "permissionKey": {
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "link": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CatalogTreeDto": {
        "required": [
          "types"
        ],
        "type": "object",
        "properties": {
          "types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogTypeDto"
            }
          }
        },
        "additionalProperties": false
      },
      "CatalogTypeDto": {
        "required": [
          "code",
          "contexts",
          "title"
        ],
        "type": "object",
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "icon": {
            "type": "string",
            "nullable": true
          },
          "contexts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogContextDto"
            }
          }
        },
        "additionalProperties": false
      },
      "FieldDto": {
        "required": [
          "caption",
          "columnNumber",
          "fieldType",
          "name"
