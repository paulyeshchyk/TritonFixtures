        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "actionId": {
            "type": "integer",
            "format": "int32"
          },
          "action": {
            "nullable": true
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "access_Level": {
            "type": "integer",
            "format": "int32"
          },
          "layoutType": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "LoadedLayoutDto": {
        "required": [
          "layout",
          "spaces",
          "values"
        ],
        "type": "object",
        "properties": {
          "layout": {
            "$ref": "#/components/schemas/LayoutDto"
          },
          "spaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpaceDto"
            }
          },
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldValueDto"
            }
          }
        },
        "additionalProperties": false
      },
      "SpaceDto": {
        "required": [
          "alias",
          "children",
          "fields",
          "id",
          "name",
          "spaceRole",
          "spaceType"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "alias": {
            "minLength": 1,
            "type": "string"
          },
          "spaceType": {
            "minLength": 1,
            "type": "string"
          },
          "spaceRole": {
            "minLength": 1,
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldDto"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpaceDto"
            }
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "layoutMode": {
            "type": "string",
            "nullable": true
          },
          "tabOrientation": {
            "type": "string",
            "nullable": true
          },
          "layoutConstraint": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "relationCode": {
            "type": "string",
            "nullable": true
          },
          "targetEntity": {
            "type": "string",
            "nullable": true
          },
          "scopedActions": {
            "type": "array",
            "items": { },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
