        "type": "object",
        "properties": {
          "fieldName": {
            "minLength": 1,
            "type": "string"
          },
          "value": { },
          "idVersion": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "meta": {
            "$ref": "#/components/schemas/FieldMetaDto"
          },
          "hasLinkToCard": {
            "type": "boolean",
            "nullable": true
          },
          "warning": {
            "$ref": "#/components/schemas/FieldWarningDto"
          },
          "unit": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FieldWarningDto": {
        "required": [
          "warningType"
        ],
        "type": "object",
        "properties": {
          "warningType": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "HealthResponse": {
        "required": [
          "checks",
          "fixturesMajor",
          "service",
          "status",
          "ts"
        ],
        "type": "object",
        "properties": {
          "service": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "minLength": 1,
            "type": "string"
          },
          "fixturesMajor": {
            "type": "integer",
            "format": "int32"
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "ts": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
