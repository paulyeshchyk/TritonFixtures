        "additionalProperties": false
      },
      "FieldMetaDto": {
        "required": [
          "isRequired",
          "readOnly",
          "visible"
        ],
        "type": "object",
        "properties": {
          "caption": {
            "type": "string",
            "nullable": true
          },
          "fieldType": {
            "type": "string",
            "nullable": true
          },
          "referenceType": {
            "type": "string",
            "nullable": true
          },
          "displayType": {
            "type": "string",
            "nullable": true
          },
          "visible": {
            "type": "boolean"
          },
          "isRequired": {
            "type": "boolean"
          },
          "readOnly": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "FieldValueDto": {
        "required": [
          "fieldName",
          "meta",
          "value"
