            "minLength": 1,
            "type": "string"
          },
          "caption": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "fieldType": {
            "minLength": 1,
            "type": "string"
          },
          "referenceType": {
            "type": "string",
